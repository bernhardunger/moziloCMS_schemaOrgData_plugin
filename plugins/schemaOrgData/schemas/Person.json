{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.org/Person",
  "title": "Person",
  "type": "object",
  "ui:typeLabel": "schema_type_person",
  "ui:idFragment": "person",
  "ui:scopes": ["global"],
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "ui:widget": "text",
      "ui:label": "label_name",
      "ui:required": true
    },
    "jobTitle": {
      "type": "string",
      "ui:widget": "text",
      "ui:label": "label_job_title",
      "ui:required": false
    },
    "description": {
      "type": "string",
      "ui:widget": "textarea",
      "ui:label": "label_description",
      "ui:required": false
    },
    "url": {
      "type": "string",
      "format": "uri",
      "ui:widget": "text",
      "ui:label": "label_url",
      "ui:placeholder": "https://www.beispiel.de",
      "ui:required": false
    },
    "image": {
      "type": "string",
      "format": "uri",
      "ui:widget": "text",
      "ui:label": "label_image",
      "ui:placeholder": "https://www.beispiel.de/bild.jpg",
      "ui:required": false
    },
    "telephone": {
      "type": "string",
      "ui:widget": "text",
      "ui:label": "label_telephone",
      "ui:placeholder": "+49 89 12345678",
      "ui:required": false
    },
    "email": {
      "type": "string",
      "format": "email",
      "ui:widget": "text",
      "ui:label": "label_email",
      "ui:placeholder": "info@beispiel.de",
      "ui:required": false
    }
  }
}
