{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.org/JobPosting",
  "title": "JobPosting",
  "type": "object",
  "ui:typeLabel": "schema_type_jobposting",
  "ui:scopes": ["page"],
  "required": ["title", "description"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "ui:widget": "text",
      "ui:label": "label_title",
      "ui:required": true
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "ui:widget": "textarea",
      "ui:label": "label_description",
      "ui:required": true
    },
    "datePosted": {
      "type": "string",
      "format": "date-time",
      "ui:widget": "text",
      "ui:label": "label_date_posted",
      "ui:placeholder": "15.03.2026",
      "ui:required": false
    },
    "validThrough": {
      "type": "string",
      "format": "date-time",
      "ui:widget": "text",
      "ui:label": "label_valid_through",
      "ui:placeholder": "15.03.2026",
      "ui:required": false
    },
    "employmentType": {
      "type": "string",
      "ui:widget": "select",
      "ui:label": "label_employment_type",
      "ui:required": false,
      "enum": [
        "https://schema.org/FULL_TIME",
        "https://schema.org/PART_TIME",
        "https://schema.org/CONTRACTOR",
        "https://schema.org/TEMPORARY",
        "https://schema.org/INTERN",
        "https://schema.org/VOLUNTEER",
        "https://schema.org/OTHER"
      ],
      "ui:enumLabels": {
        "deDE": {
          "https://schema.org/FULL_TIME": "Vollzeit",
          "https://schema.org/PART_TIME": "Teilzeit",
          "https://schema.org/CONTRACTOR": "Auftragnehmer",
          "https://schema.org/TEMPORARY": "Befristet",
          "https://schema.org/INTERN": "Praktikum",
          "https://schema.org/VOLUNTEER": "Ehrenamtlich",
          "https://schema.org/OTHER": "Sonstige"
        },
        "enEN": {
          "https://schema.org/FULL_TIME": "Full-time",
          "https://schema.org/PART_TIME": "Part-time",
          "https://schema.org/CONTRACTOR": "Contractor",
          "https://schema.org/TEMPORARY": "Temporary",
          "https://schema.org/INTERN": "Internship",
          "https://schema.org/VOLUNTEER": "Volunteer",
          "https://schema.org/OTHER": "Other"
        }
      }
    },
    "url": {
      "type": "string",
      "format": "uri",
      "ui:widget": "text",
      "ui:label": "label_url",
      "ui:placeholder": "https://www.beispiel.de/jobs/stelle",
      "ui:required": false
    }
  }
}
