{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.org/JobPosting",
  "title": "JobPosting",
  "type": "object",
  "ui:typeLabel": "schema_type_jobposting",
  "ui:scopes": ["page"],
  "required": ["title", "description", "datePosted", "hiringOrganization", "jobLocation"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "ui:widget": "text",
      "ui:label": "label_title",
      "ui:required": true
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "ui:widget": "textarea",
      "ui:label": "label_description",
      "ui:required": true
    },
    "datePosted": {
      "type": "string",
      "format": "date-time",
      "ui:widget": "text",
      "ui:label": "label_date_posted",
      "ui:placeholder": "TT.MM.YYYY",
      "ui:required": true
    },
    "validThrough": {
      "type": "string",
      "format": "date-time",
      "ui:widget": "text",
      "ui:label": "label_valid_through",
      "ui:placeholder": "TT.MM.YYYY",
      "ui:required": false
    },
    "employmentType": {
      "type": "string",
      "ui:widget": "select",
      "ui:label": "label_employment_type",
      "ui:required": false,
      "enum": [
        "https://schema.org/FULL_TIME",
        "https://schema.org/PART_TIME",
        "https://schema.org/CONTRACTOR",
        "https://schema.org/TEMPORARY",
        "https://schema.org/INTERN",
        "https://schema.org/VOLUNTEER",
        "https://schema.org/OTHER"
      ],
      "ui:enumLabels": {
        "deDE": {
          "https://schema.org/FULL_TIME": "Vollzeit",
          "https://schema.org/PART_TIME": "Teilzeit",
          "https://schema.org/CONTRACTOR": "Auftragnehmer",
          "https://schema.org/TEMPORARY": "Befristet",
          "https://schema.org/INTERN": "Praktikum",
          "https://schema.org/VOLUNTEER": "Ehrenamtlich",
          "https://schema.org/OTHER": "Sonstige"
        },
        "enEN": {
          "https://schema.org/FULL_TIME": "Full-time",
          "https://schema.org/PART_TIME": "Part-time",
          "https://schema.org/CONTRACTOR": "Contractor",
          "https://schema.org/TEMPORARY": "Temporary",
          "https://schema.org/INTERN": "Internship",
          "https://schema.org/VOLUNTEER": "Volunteer",
          "https://schema.org/OTHER": "Other"
        }
      }
    },
    "url": {
      "type": "string",
      "format": "uri",
      "ui:widget": "text",
      "ui:label": "label_url",
      "ui:placeholder": "https://www.beispiel.de/jobs/stelle",
      "ui:required": false
    },
    "hiringOrganization": {
      "type": "object",
      "ui:widget": "id_reference_or_literal",
      "ui:label": "label_hiring_organization",
      "ui:required": true,
      "ui:literalFields": ["name"],
      "ui:literalType": "Organization"
    },
    "jobLocation": {
      "type": "object",
      "ui:widget": "place",
      "ui:label": "label_job_location",
      "ui:required": true,
      "properties": {
        "name": {
          "type": "string",
          "ui:widget": "text",
          "ui:label": "label_name",
          "ui:required": false
        },
        "address": {
          "$ref": "#/definitions/PostalAddress"
        }
      }
    }
  },
  "definitions": {
    "PostalAddress": {
      "$id": "https://schema.org/PostalAddress",
      "title": "PostalAddress",
      "type": "object",
      "ui:widget": "postal_address",
      "ui:label": "label_address",
      "ui:required": false,
      "required": ["addressLocality", "addressCountry"],
      "properties": {
        "streetAddress": {
          "type": "string",
          "ui:widget": "text",
          "ui:label": "label_street_address",
          "ui:required": false
        },
        "postalCode": {
          "type": "string",
          "ui:widget": "text",
          "ui:label": "label_postal_code",
          "ui:required": false
        },
        "addressLocality": {
          "type": "string",
          "ui:widget": "text",
          "ui:label": "label_address_locality",
          "ui:required": true
        },
        "addressRegion": {
          "type": "string",
          "ui:widget": "text",
          "ui:label": "label_address_region",
          "ui:required": false
        },
        "addressCountry": {
          "type": "string",
          "ui:widget": "select",
          "ui:label": "label_address_country",
          "ui:required": true,
          "default": "DE",
          "enum": [
            "DE", "AT", "CH", "LI", "FR", "IT", "ES", "PT",
            "NL", "BE", "LU", "PL", "CZ", "DK", "SE", "NO",
            "FI", "GB", "IE", "US"
          ],
          "ui:enumLabels": {
            "deDE": {
              "DE": "Deutschland",
              "AT": "Österreich",
              "CH": "Schweiz",
              "LI": "Liechtenstein",
              "FR": "Frankreich",
              "IT": "Italien",
              "ES": "Spanien",
              "PT": "Portugal",
              "NL": "Niederlande",
              "BE": "Belgien",
              "LU": "Luxemburg",
              "PL": "Polen",
              "CZ": "Tschechien",
              "DK": "Dänemark",
              "SE": "Schweden",
              "NO": "Norwegen",
              "FI": "Finnland",
              "GB": "Vereinigtes Königreich",
              "IE": "Irland",
              "US": "Vereinigte Staaten"
            },
            "enEN": {
              "DE": "Germany",
              "AT": "Austria",
              "CH": "Switzerland",
              "LI": "Liechtenstein",
              "FR": "France",
              "IT": "Italy",
              "ES": "Spain",
              "PT": "Portugal",
              "NL": "Netherlands",
              "BE": "Belgium",
              "LU": "Luxembourg",
              "PL": "Poland",
              "CZ": "Czechia",
              "DK": "Denmark",
              "SE": "Sweden",
              "NO": "Norway",
              "FI": "Finland",
              "GB": "United Kingdom",
              "IE": "Ireland",
              "US": "United States"
            }
          }
        }
      }
    }
  }
}
